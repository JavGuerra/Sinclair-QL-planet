<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title><%= site.title %></title>
  <link href="<%= site.url %>/atom.xml" rel="self" type="application/atom+xml"/>
  <link href="<%= site.url %>"/>
  <updated><%= Time.now.xmlschema %></updated>
  <id><%= site.url %></id>

  <% items.first(20).each do |item| %>
  <entry>
    <title><%= item.title %></title>
    <link href="<%= item.url %>"/>
    <updated><%= item.updated.xmlschema %></updated>
    <id><%= item.url %></id>
    <content type="html"><![CDATA[<%= item.content %>]]></content>
    <author>
      <name><%= item.feed.title %></name>
    </author>
  </entry>
  <% end %>
</feed>