<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset='utf-8'>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name='generator' content='<%= Pluto.generator %>'>

  <title><%= site.title %></title>

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg width='128' height='128' viewBox='0 0 33.867 33.867' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='m10.025 25.964c1.5961 0.028 2.6321-0.16801 4.0882-0.72803l5.1522 3.2762 1.9321-2.8001-4.2842-2.1561c2.5761-2.1561 3.6682-4.5922 3.6682-7.9804-0.028-5.6003-4.5362-10.193-10.221-10.221-5.7123-0.028-10.361 4.6482-10.361 10.305 0 5.5723 4.4522 10.193 10.024 10.305zm-6.3843-10.136c-0.084-4.0042 2.5481-7.5324 6.7763-7.5324 4.1722 0 6.5523 3.6962 6.4683 7.5044-0.084 3.7802-2.5481 7.1684-6.6363 7.1684-3.8642 0-6.5243-3.3882-6.6083-7.1404zm19.194 9.7445h11.033v-3.1082h-7.3924v-16.633h-3.6402z' stroke-linecap='round' stroke-width='1.163' aria-label='QL'/%3E%3Cstyle%3Epath%7Bfill:%23000%7D@media (prefers-color-scheme:dark)%7Bpath%7Bfill:%23fff%7D%7D%3C/style%3E%3C/svg%3E">

  <%= stylesheet_link_tag 'css/planet.starter' %>
</head>
<body>

<div id='page'>

  <header id='header'>
    <h1><%= site.title %></h1>
  </header>

  <div id='layout'>

    <main id='main'>
      <!-- 1) Lista de titulares con enlaces internos -->
      <section class='contents' aria-labelledby="contents-heading">
        <h2 id="contents-heading" class="contents-title">Contents</h2>
        <ol>
        <% site.items.latest.limit(17).each_with_index do |item,index| %>
          <li>
              <%= link_to item.title, '#'+"#{index+1}" %>
              <span class='item-feed-title'>
                &bull; <%= link_to item.feed.title, item.feed.url %>
              </span>
              <span class='item-updated'>
                 &bull; <%= time_ago_in_words( item.updated ) %>
              </span>
          </li>
        <% end %>
        </ol>
      </section>

      <!-- 2) Artículos completos -->
      <%
         items = site.items.latest.limit(17)
         index = 0
         ItemCursor.new( items ).each do |item, new_date, new_feed|
           index += 1
      %>

      <% if new_date %>
       <h2 class='new-date'>
        <%= item.updated.strftime('%A, %d. %B %Y') %>
       </h2>
      <% else %>
        <hr class='item-seperator'>
      <% end %>

      <article class='item' id='<%= "#{index}" %>'>
        <% if new_feed %>
        <div class='feed-title'>
          <%= link_to item.feed.title, item.feed.url %>
        </div>
        <% end %>

        <h3 class='item-title'>
         <%= link_to item.title, item.url %>
        </h3>

        <!-- Metadatos (Autor, Hora y Tiempo) debajo del título -->
        <div class='item-meta'>
          <% if item.author %>
            <span class='item-author'>Por <%= item.author %></span> &bull;
          <% else %>
            <span class='item-author'><%= link_to item.feed.title, item.feed.url %></span> &bull;
          <% end %>
          <span class='item-updated'><%= item.updated.strftime('%H:%M GMT') %> (<%= time_ago_in_words(item.updated) %>)</span>
        </div>

        <div class='item-body'>
          <div class='item-content item-summary'>
          <% if item.content %>
            <%= item.content %>
          <% elsif item.summary %>
            <%= item.summary %>
          <% else %>
            -/-
          <% end %>
          </div>
        </div>
      </article>

      <% end %>
    </main>

    <aside id='navwrap'>
      <nav id='nav' aria-label="Menú principal">
        <p><strong>Last Update</strong></p>
        <p class="small">
          <%= (site.updated || Time.now.utc).utc.strftime('%A, %d %b %Y %H:%M GMT') %>
        </p>

        <p><strong>Planet Feeds</strong></p>
        <ul class='planet-feeds small'>
          <li>
            <%= image_tag('i/feed-icon-10x10.png', alt: 'RSS XML') %>
            <a href="feed.xml">RSS</a>
          </li>
          <li>
            <%= image_tag('i/feed-icon-10x10.png', alt: 'Atom XML') %>
            <a href="atom.xml">ATOM</a>
          </li>
        </ul>

        <p><strong>Subscriptions</strong></p>
        <ul class='subscriptions small'>
         <% site.feeds.each do |feed| %>
          <li>
            <%= link_to( image_tag('i/feed-icon-10x10.png', alt: 'Feed RSS'), feed.feed_url ) %>
            <%= link_to feed.title, feed.url %>
          </li>
         <% end %>
        </ul>

        <p><strong>Meta</strong></p>
        <p class='small'>Powered by <a href='https://github.com/feedreader'>Pluto</a></p>
      </nav>
    </aside>

  </div><!-- /#layout -->

</div><!-- /#page -->

</body>
</html>